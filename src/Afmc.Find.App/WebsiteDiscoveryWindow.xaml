<Window x:Class="Afmc.Find.App.WebsiteDiscoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="配置 Torznab 搜索源" Width="820" Height="680" MinWidth="640" MinHeight="500" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock Text="连接你的搜索源" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="粘贴网站网址，让软件寻找并验证公开搜索入口。" Foreground="{StaticResource Muted}"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,20,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="WebsiteBox" Style="{StaticResource CompactInput}" Height="42" AutomationProperties.Name="网站网址" ToolTip="https://example.com/" TextChanged="InputChanged"/>
   <Button x:Name="DetectButton" Grid.Column="1" Content="识别 / 刷新" Click="Detect" Style="{StaticResource Primary}" Margin="12,0,0,0"/>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="验证词（可选）" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="ProbeQueryBox" Grid.Column="1" Style="{StaticResource CompactInput}" Height="36" ToolTip="留空时自动选取本站样本；也可填写本站确有的作品名" AutomationProperties.Name="验证关键词" TextChanged="InputChanged"/>
   <Button x:Name="CancelProbeButton" Grid.Column="2" Content="停止探测" Click="CancelProbe" IsEnabled="False" Margin="12,0,0,0"/>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,12,0,12"><TextBlock Text="自动检查静态与动态搜索、详情页和下载按钮；复杂网站可能需约 2 分钟，可随时停止。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="OutcomeText" Text="等待输入网址" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel>
  <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
   <TextBox x:Name="ProbeLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" FontSize="12" AutomationProperties.Name="探测过程"/>
   <ListBox x:Name="PreviewList" Grid.Row="1" Margin="0,12,0,0" AutomationProperties.Name="验证结果"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding ResourceType}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  </Grid>
  <Grid Grid.Row="5" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="CatalogButton" Content="浏览已适配目录" Click="OpenCatalog" HorizontalAlignment="Left"/>
   <Button Grid.Column="1" Content="取消" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="SaveDiscoveryButton" Grid.Column="2" Content="添加已验证来源" Style="{StaticResource Primary}" Click="Save" IsEnabled="False"/>
  </Grid>
 </Grid>
</Window>
