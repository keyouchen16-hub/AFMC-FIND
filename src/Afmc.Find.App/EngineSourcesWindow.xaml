<Window x:Class="Afmc.Find.App.EngineSourcesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="配置 Torznab 搜索源" Width="900" Height="720" MinWidth="680" MinHeight="480" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock Text="连接你的搜索源" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="选择网站，在这里完成配置。公开来源通常不需要账号。" Foreground="{StaticResource Muted}"/></StackPanel>
  <StackPanel x:Name="CatalogFilters" Grid.Row="1" Margin="0,18,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FindSourceBox" AutomationProperties.Name="搜索网站名称或网址" Style="{StaticResource CompactInput}" Height="40" TextChanged="FilterChanged" ToolTip="输入网站名称或网址"/><Button x:Name="ReloadButton" Grid.Column="1" Content="刷新目录" Click="Reload" Margin="12,0,0,0"/></Grid>
   <WrapPanel Margin="0,10,0,0"><ComboBox x:Name="AccessFilter" Style="{StaticResource CompactSelect}" Width="180" SelectedIndex="0" SelectionChanged="CategoryChanged" AutomationProperties.Name="访问方式"><ComboBoxItem Content="全部 · 公开优先"/><ComboBoxItem Content="仅公开来源"/><ComboBoxItem Content="需要账号 / 部分限制"/></ComboBox><ComboBox x:Name="ResourceFilter" Style="{StaticResource CompactSelect}" Width="150" Margin="12,0,0,0" SelectedIndex="0" SelectionChanged="CategoryChanged" AutomationProperties.Name="资源类型"><ComboBoxItem Content="全部资源"/><ComboBoxItem Content="动漫"/><ComboBoxItem Content="电影"/><ComboBoxItem Content="剧集/视频"/><ComboBoxItem Content="音乐"/><ComboBoxItem Content="书籍"/><ComboBoxItem Content="软件"/><ComboBoxItem Content="游戏"/><ComboBoxItem Content="其他"/><ComboBoxItem Content="未标明"/></ComboBox></WrapPanel>
  </StackPanel>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="CatalogColumn" Width="290"/><ColumnDefinition x:Name="CatalogGap" Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ListBox x:Name="CatalogList" SelectionChanged="SelectSource" AutomationProperties.Name="搜索源目录"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding CategoryLabel}" FontSize="12" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Border Grid.Column="2" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="10" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock x:Name="SelectedName" Text="选择一个来源" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="SelectedSite" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
    <TextBlock x:Name="SelectedDescription" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
    <StackPanel x:Name="FieldsPanel" Margin="0,0,18,0"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Text="正在准备内置搜索引擎…" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,16,0"/>
   <Button Grid.Column="1" Content="取消" IsCancel="True" Margin="0,0,10,0"/>
   <Button x:Name="AddButton" Grid.Column="2" Content="测试并添加" Style="{StaticResource Primary}" Click="Add" IsEnabled="False"/>
  </Grid>
 </Grid>
</Window>
