<Window x:Class="Afmc.Find.App.PreferencesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Afmc.Find.App"
 Title="AFMC FIND · 设置" Icon="Assets/afmc-find.ico" Width="560" Height="720" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F4F2F0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="Focus" Padding="0,14" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
          <Grid><ContentPresenter Margin="0,0,60,0" VerticalAlignment="Center"/>
            <Border x:Name="Track" Width="40" Height="23" CornerRadius="12" Background="#59616B" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse x:Name="Knob" Width="17" Height="17" Fill="#F4F2F0" HorizontalAlignment="Left" Margin="3,0"/></Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Focus" Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="SettingCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,4,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <Border Background="{StaticResource DialogGlassTint}" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="0">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="36">
        <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center"><Image Source="Assets/afmc-find.png" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="{x:Static local:ProductInfo.Title}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
        <Button Content="&#xE8BB;" FontSize="11" Style="{StaticResource SettingsIconButton}" HorizontalAlignment="Right" IsCancel="True" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭设置" AutomationProperties.Name="关闭设置"/>
      </Grid>
      <Grid Margin="24,16,24,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Image x:Name="SettingsFamilyMark" Source="Assets/family-mark.png" Width="90" Height="70" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.85" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="SAINTS FOR MY FAMILY 标志"/>
        <StackPanel Margin="0,0,106,22"><TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="让工具安静地配合你的习惯" Style="{StaticResource SettingCaption}"/></StackPanel>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0,0,4,10">
          <StackPanel>
            <TextBlock Text="窗口行为" Style="{StaticResource SettingHeading}"/>
            <Border Style="{StaticResource GlassPanel}" Padding="14,0"><StackPanel>
              <CheckBox x:Name="CloseToTrayBox" Style="{StaticResource Switch}" AutomationProperties.Name="关闭窗口时收起到托盘"><StackPanel><TextBlock Text="关闭后留在托盘" FontSize="14"/><TextBlock Text="保留搜索结果，点击托盘图标即可回来" Style="{StaticResource SettingCaption}"/></StackPanel></CheckBox>
              <Border Height="1" Background="#18FFFFFF"/>
              <CheckBox x:Name="MinimizeToTrayBox" Style="{StaticResource Switch}" AutomationProperties.Name="最小化时收起到托盘"><StackPanel><TextBlock Text="最小化时收起到托盘" FontSize="14"/><TextBlock Text="关闭此项时，最小化仍保留在任务栏" Style="{StaticResource SettingCaption}"/></StackPanel></CheckBox>
            </StackPanel></Border>
            <TextBlock Text="界面体验" Style="{StaticResource SettingHeading}" Margin="0,16,0,8"/>
            <Border Style="{StaticResource GlassPanel}" Padding="14,0"><CheckBox x:Name="ReduceMotionBox" Style="{StaticResource Switch}" AutomationProperties.Name="减少动态效果"><StackPanel><TextBlock Text="减少动态效果" FontSize="14"/><TextBlock Text="关闭详情淡入等过渡；同时尊重系统动画设置" Style="{StaticResource SettingCaption}"/></StackPanel></CheckBox></Border>
            <TextBlock Text="本机记录" Style="{StaticResource SettingHeading}" Margin="0,16,0,8"/>
            <Border x:Name="HistoryCard" Style="{StaticResource GlassPanel}" Padding="14,0"><CheckBox x:Name="RememberHistoryBox" Style="{StaticResource Switch}" AutomationProperties.Name="记录搜索历史"><StackPanel><TextBlock Text="记录搜索历史" FontSize="14"/><TextBlock Text="最近50条，仅保存在本机" Style="{StaticResource SettingCaption}"/></StackPanel></CheckBox></Border>
            <Border x:Name="SettingsFeedbackCard" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,18,0,4"><StackPanel>
              <StackPanel Orientation="Horizontal"><Image x:Name="SettingsBrandLogo" Source="Assets/afmc-find.png" Width="22" Height="28" Margin="0,0,10,0"/><TextBlock Text="Find the You." FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
              <TextBlock Text="你的建议，留给下一版。" Style="{StaticResource SettingCaption}" Margin="0,8,0,10"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Static local:ProductInfo.FeedbackEmail}" FontSize="13" VerticalAlignment="Center"/><Button x:Name="SettingsCopyEmail" Grid.Column="1" Content="复制邮箱" Style="{StaticResource CompactButton}" Height="32" Padding="12,0" Click="CopyEmailClick"/></Grid>
              <TextBlock x:Name="SettingsFeedbackHint" Text="" Style="{StaticResource SettingCaption}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="托盘菜单可彻底退出" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" IsCancel="True" Height="36" Padding="16,0" Margin="0,0,8,0"/><Button Content="保存设置" Style="{StaticResource Primary}" Height="36" Padding="18,0" IsDefault="True" Click="SaveClick"/></StackPanel>
        </Grid>
      </Grid>
    </DockPanel>
  </Border>
</Window>
