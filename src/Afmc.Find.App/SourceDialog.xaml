<Window x:Class="Afmc.Find.App.SourceDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="配置 Torznab 搜索源" Width="660" Height="650" MinHeight="450" WindowStartupLocation="CenterOwner">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
<TextBlock Text="连接你的搜索源" FontSize="24" FontWeight="SemiBold"/>
<TextBlock x:Name="HintText" Text="连接自己的 Jackett，勾选已配置的来源即可导入。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,20"/>
<TextBlock x:Name="AddressLabel" Text="Jackett 地址或完整 Torznab 链接"/>
<TextBox x:Name="EndpointBox" AutomationProperties.Name="Torznab API 地址" MaxLength="4096" Height="42" Padding="12,6" Margin="0,6,0,12"/>
<TextBlock Text="API Key"/><PasswordBox x:Name="KeyBox" AutomationProperties.Name="API Key" Height="38" Padding="12,6" Margin="0,6,0,6"/>
<TextBlock Text="从自己的 Jackett 页面复制；完整链接含 Key 时会自动提取。" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
<Button x:Name="ConnectButton" Content="读取搜索源" Click="Connect" HorizontalAlignment="Left" Margin="0,14,0,10"/>
<ListBox x:Name="IndexerList" Height="145" Visibility="Collapsed" SelectionMode="Multiple" AutomationProperties.Name="可导入的搜索源">
<ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" Margin="4"/></DataTemplate></ListBox.ItemTemplate>
</ListBox>
<StackPanel x:Name="EditOptions" Visibility="Collapsed"><TextBlock Text="名称"/><TextBox x:Name="NameBox" MaxLength="80" AutomationProperties.Name="搜索源名称"/><CheckBox x:Name="EnabledBox" Content="启用该搜索源" IsChecked="True"/></StackPanel>
<TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#F3BC89" Margin="0,12,0,12"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="SaveButton" Content="导入所选" IsEnabled="False" Style="{StaticResource Primary}" Click="Save"/></StackPanel>
</StackPanel></ScrollViewer></Window>
